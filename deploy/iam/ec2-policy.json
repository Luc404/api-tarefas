      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::api-tarefas-artefatos-178817475770",
        "arn:aws:s3:::api-tarefas-artefatos-178817475770/*"
      ]
    },
    {
      "Sid": "CodeDeployAgentBucket",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::aws-codedeploy-sa-east-1",
        "arn:aws:s3:::aws-codedeploy-sa-east-1/*"
      ]
    }
  ]
}
