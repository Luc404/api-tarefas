{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3Artifacts",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:PutObjectAcl",
        "s3:GetBucketVersioning",
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::api-tarefas-artefatos-178817475770",
        "arn:aws:s3:::api-tarefas-artefatos-178817475770/*"
      ]
    },
    {
      "Sid": "StartBuild",
      "Effect": "Allow",
      "Action": [
        "codebuild:BatchGetBuilds",
        "codebuild:StartBuild",
        "codebuild:StopBuild"
      ],
      "Resource": "arn:aws:codebuild:sa-east-1:178817475770:project/api-tarefas-build"
    },
    {
      "Sid": "Deploy",
      "Effect": "Allow",
      "Action": [
        "codedeploy:CreateDeployment",
        "codedeploy:GetDeployment",
        "codedeploy:BatchGetDeployments",
        "codedeploy:GetDeploymentConfig",
        "codedeploy:ListDeployments",
        "codedeploy:ListDeploymentGroups",
        "codedeploy:GetDeploymentGroup",
        "codedeploy:GetApplication",
        "codedeploy:ListApplications",
        "codedeploy:RegisterApplicationRevision"
      ],
      "Resource": [
        "arn:aws:codedeploy:sa-east-1:178817475770:application:api-tarefas",
        "arn:aws:codedeploy:sa-east-1:178817475770:deploymentgroup:api-tarefas/api-tarefas-dg",
        "arn:aws:codedeploy:sa-east-1:178817475770:deploymentconfig:CodeDeployDefault.OneAtATime",
        "arn:aws:codedeploy:sa-east-1:178817475770:deployment:*"
      ]
    },
    {
      "Sid": "GitHubConnection",
      "Effect": "Allow",
      "Action": "codestar-connections:UseConnection",
      "Resource": "arn:aws:codeconnections:sa-east-1:178817475770:connection/*"
    },
    {
      "Sid": "PassRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::178817475770:role/api-tarefas-codebuild-role",
        "arn:aws:iam::178817475770:role/api-tarefas-codedeploy-role"
      ]
    },
    {
      "Sid": "WebhookEvents",
      "Effect": "Allow",
      "Action": [
        "events:PutTargets",
        "events:PutRule",
        "events:DescribeRule"
      ],
      "Resource": "arn:aws:events:sa-east-1:178817475770:rule/CodePipelineRule*"
    }
  ]
}
